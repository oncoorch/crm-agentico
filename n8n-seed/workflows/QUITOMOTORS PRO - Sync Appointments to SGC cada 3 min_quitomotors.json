      "parameters": {
        "jsCode": "const result = $json || {};\nconst chatwootSync = result.chatwoot_sync_result || null;\nreturn [{ json: {\n  ok: Boolean(result.ok),\n  skipped: Boolean(result.skipped),\n  appointment_id: result.appointment_id || null,\n  sgc_sync_status: result.sgc_sync_status || null,\n  sgc_lead_id: result.sgc_lead_id || null,\n  sgc_result: result.sgc_result || null,\n  chatwoot_sync_result: chatwootSync,\n  labels_synced: Boolean(chatwootSync?.labels_result?.ok),\n  message: result.message || result.error || null,\n  raw: result,\n} }];"
      },
