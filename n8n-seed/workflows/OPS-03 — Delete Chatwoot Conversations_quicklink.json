        "jsCode": "const items = $input.all();\nconst results = items.map(item => {\n  const row = item.json || {};\n  return {\n    id: row.id,\n    action: row.dry_run ? 'dry_run_get' : 'delete',\n    statusCode: row.statusCode || 0,\n    ok: row.http_ok !== false && !row.error,\n    error: row.error?.message || row.message || null,\n  };\n});\nconst summary = results.reduce((acc, row) => {\n  const key = String(row.statusCode || 'error');\n  acc[key] = (acc[key] || 0) + 1;\n  return acc;\n}, {});\nreturn [{ json: { targeted: results.length, summary, results } }];"
