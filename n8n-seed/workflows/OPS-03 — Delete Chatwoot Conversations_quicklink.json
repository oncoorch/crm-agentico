      "parameters": {
        "jsCode": "const requested = $('Code - Normalize Request').all().map(item => item.json || {});\nreturn $input.all().map((item, index) => {\n  const row = item.json || {};\n  const req = requested[index] || {};\n  const statusCode = Number(row.statusCode || row.status || row.responseCode || row.status_code || 0);\n  const parseOnlyError = !req.dry_run && /Invalid JSON in response body/i.test(String(row.error || ''));\n  const okStatus = statusCode >= 200 && statusCode < 300 || statusCode === 404;\n  const httpOk = parseOnlyError || (!row.error && (statusCode ? okStatus : true));\n  return {\n    json: {\n      ...row,\n      id: row.id || req.id || null,\n      dry_run: req.dry_run === true,\n      http_ok: httpOk,\n      statusCode: statusCode || (parseOnlyError ? 200 : (row.error ? 0 : 200)),\n      error: httpOk ? null : row.error,\n    },\n  };\n});"
