        "jsCode": "const src = $json.body || $json || {};\nconst ids = Array.isArray(src.chatwoot_conv_ids) ? src.chatwoot_conv_ids.map(Number).filter(Boolean) : [];\nconst dryRun = src.dry_run !== false && String(src.dry_run ?? 'true').toLowerCase() !== 'false';\nconst confirm = String(src.confirm || '');\nif (!ids.length) throw new Error('chatwoot_conv_ids is required');\nif (!dryRun && confirm !== 'DELETE_CHATWOOT_CONVERSATIONS') throw new Error('Real delete requires confirm=DELETE_CHATWOOT_CONVERSATIONS');\nconst accountId = Number(src.account_id || 2);\nconst baseUrl = String(src.base_url || 'http://chatwoot:3000').replace(/\\/$/, '');\nreturn ids.map(id => ({ json: { id, dry_run: dryRun, account_id: accountId, base_url: baseUrl } }));"
