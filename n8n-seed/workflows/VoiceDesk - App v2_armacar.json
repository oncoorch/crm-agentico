      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>VoiceDesk</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,sans-serif}\nbody{background:#f0f0ef;color:#1a1a1a}\n.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.login-card{background:#fff;border:1px solid #e5e5e5;border-radius:16px;padding:32px;width:360px}\n.logo-box{width:44px;height:44px;background:#EEF2FF;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:22px}\n.login-title{font-size:20px;font-weight:600;margin-bottom:4px}\n.login-sub{font-size:14px;color:#666;margin-bottom:24px}\n.field{margin-bottom:14px}\n.field label{display:block;font-size:12px;color:#666;margin-bottom:4px}\n.field input{width:100%;padding:9px 12px;border:1px solid #e5e5e5;border-radius:8px;font-size:14px;outline:none;transition:border 0.15s}\n.field input:focus{border-color:#6366f1}\n.btn{width:100%;padding:10px;border-radius:8px;font-size:14px;cursor:pointer;border:none;font-weight:500}\n.btn-primary{background:#6366f1;color:#fff}\n.btn-primary:hover{background:#4f46e5}\n.error-box{background:#FEF2F2;color:#DC2626;padding:8px 12px;border-radius:8px;font-size:13px;margin-bottom:12px;display:none}\n.app{display:none;min-height:100vh;flex-direction:column}\n.topbar{display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:52px;background:#fff;border-bottom:1px solid #e5e5e5;position:sticky;top:0;z-index:100}\n.app-logo{font-size:15px;font-weight:600;color:#6366f1;display:flex;align-items:center;gap:8px}\n.nav{display:flex;gap:2px}\n.nav-item{padding:6px 14px;border-radius:8px;font-size:13px;cursor:pointer;border:none;background:transparent;color:#666;transition:all 0.15s}\n.nav-item.active{background:#EEF2FF;color:#6366f1;font-weight:500}\n.nav-item:hover:not(.active){background:#f5f5f5}\n.user-area{display:flex;align-items:center;gap:10px}\n.avatar{width:30px;height:30px;border-radius:50%;background:#EEF2FF;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#6366f1}\n.user-email{font-size:13px;color:#666}\n.logout-btn{padding:5px 12px;border-radius:8px;font-size:12px;cursor:pointer;border:1px solid #e5e5e5;background:#fff;color:#666}\n.content{flex:1;padding:24px;max-width:1100px;margin:0 auto;width:100%}\n.page{display:none}\n.page.active{display:block}\n.page-title{font-size:20px;font-weight:600;margin-bottom:2px}\n.page-sub{font-size:13px;color:#888;margin-bottom:20px}\n.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:20px}\n.metric{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:14px}\n.metric-label{font-size:11px;color:#888;margin-bottom:4px}\n.metric-value{font-size:22px;font-weight:600}\n.metric-sub{font-size:11px;color:#aaa;margin-top:2px}\n.card{background:#fff;border:1px solid #e5e5e5;border-radius:12px;margin-bottom:14px}\n.card-head{padding:12px 16px;border-bottom:1px solid #f0f0f0;font-size:13px;font-weight:600}\n.filters{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}\nselect,.search-input{padding:7px 12px;border:1px solid #e5e5e5;border-radius:8px;font-size:13px;background:#fff;outline:none}\nselect:focus,.search-input:focus{border-color:#6366f1}\n.search-input{flex:1;min-width:180px}\n.tbl-wrap{overflow-x:auto}\ntable{width:100%;border-collapse:collapse;font-size:13px}\nth{text-align:left;padding:9px 12px;color:#888;font-weight:500;border-bottom:1px solid #f0f0f0;white-space:nowrap}\ntd{padding:9px 12px;border-bottom:1px solid #fafafa;vertical-align:middle}\ntr:last-child td{border-bottom:none}\ntr:hover td{background:#fafafa}\n.badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:500}\n.b-si{background:#DCFCE7;color:#16A34A}\n.b-no{background:#FEF2F2;color:#DC2626}\n.b-in{background:#EEF2FF;color:#6366f1}\n.b-gray{background:#f5f5f5;color:#666}\n.btn-sm{padding:4px 10px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid #e5e5e5;background:#fff;color:#444}\n.btn-sm:hover{background:#f5f5f5}\n.loading{text-align:center;padding:32px;color:#aaa;font-size:13px}\n.client-row{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid #e5e5e5;border-radius:10px;margin-bottom:8px;background:#fff}\n.client-info{display:flex;align-items:center;gap:12px}\n.c-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n\n/* DETAIL */\n.detail-panel{border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;margin-top:12px;display:none;background:#fff}\n.detail-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;padding:12px 14px;border-bottom:1px solid #f0f0f0}\n.meta-item label{font-size:11px;color:#aaa;display:block;margin-bottom:2px}\n.meta-item span{font-size:13px;font-weight:500}\n\n/* AUDIO PLAYER REAL */\n.audio-player{padding:14px;border-bottom:1px solid #f0f0f0;background:#fafafa}\n.audio-player-title{font-size:11px;color:#888;margin-bottom:8px;font-weight:500;display:flex;align-items:center;gap:6px}\n.audio-native{width:100%;height:36px;outline:none;border-radius:8px}\n.audio-native::-webkit-media-controls-panel{background:#fff;border:1px solid #e5e5e5;border-radius:8px}\n.audio-dl{display:inline-flex;align-items:center;gap:5px;margin-top:8px;font-size:12px;color:#6366f1;text-decoration:none;padding:4px 10px;border:1px solid #c7d2fe;border-radius:6px;background:#EEF2FF}\n.audio-dl:hover{background:#e0e7ff}\n.no-audio{font-size:12px;color:#aaa;padding:10px 0}\n\n/* CHAT WHATSAPP */\n.chat-box{padding:14px;display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;background:#f0ece4}\n.msg-row{display:flex;gap:8px;align-items:flex-end}\n.msg-row.ai{flex-direction:row}\n.msg-row.usr{flex-direction:row-reverse}\n.msg-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;border:2px solid #fff}\n.av-ai{background:#6366f1;color:#fff}\n.av-usr{background:#25D366;color:#fff}\n.bubble{max-width:72%;padding:8px 11px;border-radius:12px;font-size:13px;line-height:1.5;position:relative;box-shadow:0 1px 2px rgba(0,0,0,0.08)}\n.bbl-ai{background:#fff;border-bottom-left-radius:3px;color:#1a1a1a}\n.bbl-usr{background:#DCF8C6;border-bottom-right-radius:3px;color:#1a1a1a}\n.msg-name{font-size:10px;font-weight:600;margin-bottom:3px}\n.name-ai{color:#6366f1}\n.name-usr{color:#25D366;text-align:right}\n.msg-ts{font-size:10px;color:#aaa;margin-top:3px}\n.ts-right{text-align:right}\n\n/* SUMMARY */\n.summary-sec{padding:14px;border-top:1px solid #f0f0f0}\n.summary-label{font-size:12px;color:#888;margin-bottom:6px;font-weight:500;display:flex;align-items:center;gap:6px}\n.summary-text{font-size:13px;color:#444;line-height:1.7;background:#fafafa;padding:10px 12px;border-radius:8px;border:1px solid #f0f0f0}\n\n/* CONFIG */\n.config-field{margin-bottom:12px}\n.config-field label{font-size:12px;color:#666;display:block;margin-bottom:4px}\n.config-field input{width:100%;padding:8px 10px;border:1px solid #e5e5e5;border-radius:7px;font-size:12px;background:#fafafa;color:#444}\n.status-dot{width:8px;height:8px;border-radius:50%;background:#16A34A;display:inline-block}\n\n/* CHART BARS */\n.bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}\n.bar-track{flex:1;height:8px;background:#f0f0f0;border-radius:4px;overflow:hidden}\n.bar-fill{height:100%;border-radius:4px;transition:width 0.6s}\n\n@media(max-width:640px){.grid2{grid-template-columns:1fr}.content{padding:14px}.metrics{grid-template-columns:repeat(2,1fr)}}\n</style>\n</head>\n<body>\n\n<div id=\"login-wrap\" class=\"login-wrap\">\n  <div class=\"login-card\">\n    <div class=\"logo-box\">📞</div>\n    <h1 class=\"login-title\">VoiceDesk</h1>\n    <p class=\"login-sub\">Gestión de agentes de voz VAPI</p>\n    <div id=\"error-box\" class=\"error-box\">Credenciales incorrectas. Intenta de nuevo.</div>\n    <div class=\"field\"><label>Correo electrónico</label><input type=\"email\" id=\"inp-email\" placeholder=\"admin@aigentss.com\"/></div>\n    <div class=\"field\"><label>Contraseña</label><input type=\"password\" id=\"inp-pass\" placeholder=\"••••••••\"/></div>\n    <button class=\"btn btn-primary\" onclick=\"doLogin()\">Ingresar</button>\n  </div>\n</div>\n\n<div id=\"app\" class=\"app\">\n  <div class=\"topbar\">\n    <div class=\"app-logo\">📞 VoiceDesk</div>\n    <div class=\"nav\" id=\"nav-admin\">\n      <button class=\"nav-item active\" onclick=\"showPage('panel',this)\">Panel</button>\n      <button class=\"nav-item\" onclick=\"showPage('clientes',this)\">Clientes</button>\n      <button class=\"nav-item\" onclick=\"showPage('llamadas',this)\">Llamadas</button>\n      <button class=\"nav-item\" onclick=\"showPage('config',this)\">Config</button>\n    </div>\n    <div class=\"nav\" id=\"nav-cliente\" style=\"display:none\">\n      <button class=\"nav-item active\" onclick=\"showPage('mis-llamadas',this)\">Mis llamadas</button>\n      <button class=\"nav-item\" onclick=\"showPage('analytics',this)\">Analytics</button>\n      <button class=\"nav-item\" onclick=\"showPage('mi-cuenta',this)\">Mi cuenta</button>\n    </div>\n    <div class=\"user-area\">\n      <div class=\"avatar\" id=\"user-av\">AS</div>\n      <span class=\"user-email\" id=\"user-em\"></span>\n      <button class=\"logout-btn\" onclick=\"doLogout()\">Salir</button>\n    </div>\n  </div>\n\n  <div class=\"content\">\n\n    <div class=\"page active\" id=\"page-panel\">\n      <p class=\"page-title\">Panel general</p>\n      <p class=\"page-sub\">Resumen de actividad de todos los clientes</p>\n      <div class=\"metrics\" id=\"met-panel\"><div class=\"loading\">Cargando métricas...</div></div>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <div class=\"card-head\">📋 Últimas 5 llamadas</div>\n          <div class=\"tbl-wrap\"><table><thead><tr><th>Fecha</th><th>Nombre</th><th>Dur.</th><th>WA</th></tr></thead><tbody id=\"tbl-panel\"></tbody></table></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">📊 Conversión WhatsApp</div>\n          <div style=\"padding:16px\" id=\"chart-wa\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"page\" id=\"page-clientes\">\n      <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:20px\">\n        <div><p class=\"page-title\">Clientes</p><p class=\"page-sub\">Asistentes, números y credenciales</p></div>\n        <button class=\"btn-sm\" style=\"padding:7px 14px\">+ Nuevo cliente</button>\n      </div>\n      <div id=\"lista-clientes\"><div class=\"loading\">Cargando...</div></div>\n    </div>\n\n    <div class=\"page\" id=\"page-llamadas\">\n      <p class=\"page-title\">Todas las llamadas</p>\n      <p class=\"page-sub\">Click en \"Ver\" para escuchar la grabación y leer la conversación</p>\n      <div class=\"filters\">\n        <select id=\"fil-wa\" onchange=\"filtrar()\"><option value=\"\">Todos los WA</option><option value=\"SI\">Aceptó WA</option><option value=\"NO\">No aceptó</option></select>\n        <input class=\"search-input\" id=\"fil-q\" placeholder=\"Buscar nombre o teléfono...\" oninput=\"filtrar()\"/>\n      </div>\n      <div class=\"card\" style=\"padding:0\">\n        <div class=\"tbl-wrap\">\n          <table><thead><tr><th>Fecha</th><th>Nombre</th><th>Teléfono</th><th>Dur.</th><th>WA</th><th>Estado</th><th></th></tr></thead>\n          <tbody id=\"tbl-llamadas\"></tbody></table>\n        </div>\n      </div>\n      <div id=\"detail-panel\" class=\"detail-panel\">\n        <div class=\"detail-meta\" id=\"det-meta\"></div>\n        <div class=\"audio-player\" id=\"det-audio\"></div>\n        <div class=\"chat-box\" id=\"det-chat\"></div>\n        <div class=\"summary-sec\">\n          <div class=\"summary-label\">✨ Resumen de la llamada</div>\n          <div class=\"summary-text\" id=\"det-summary\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"page\" id=\"page-config\">\n      <p class=\"page-title\">Configuración</p>\n      <p class=\"page-sub\">Credenciales globales y estado del sistema</p>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <div class=\"card-head\">🔑 VAPI</div>\n          <div style=\"padding:14px\">\n            <div class=\"config-field\"><label>Webhook URL n8n</label><input value=\"https://armacar.bkn.aigentss.cloud/webhook/vapi-transcripciones\" readonly/></div>\n            <div class=\"config-field\"><label>Assistant ID</label><input value=\"f1d6d53d-2ef5-4dae-afe2-dd68f406507a\" readonly/></div>\n            <div class=\"config-field\"><label>Número</label><input value=\"+59323420121\" readonly/></div>\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">📊 Google Sheets</div>\n          <div style=\"padding:14px\">\n            <div class=\"config-field\"><label>Sheet ID</label><input value=\"1YgWSysAfZogPVeJhO-GUl_nwbURA7DmVPPKZYRGL1-w\" readonly/></div>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-top:12px\">\n              <span class=\"status-dot\"></span>\n              <span style=\"font-size:13px;color:#16A34A;font-weight:500\">Conectado</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-head\">👥 Usuarios del sistema</div>\n        <div class=\"tbl-wrap\"><table><thead><tr><th>Email</th><th>Rol</th><th>Cliente</th><th>Estado</th></tr></thead>\n        <tbody>\n          <tr><td>admin@aigentss.com</td><td><span class=\"badge b-in\">Super admin</span></td><td>Todos</td><td><span class=\"badge b-si\">Activo</span></td></tr>\n          <tr><td>bsol@client.com</td><td><span class=\"badge b-gray\">Cliente</span></td><td>Banco Solidario</td><td><span class=\"badge b-si\">Activo</span></td></tr>\n        </tbody></table></div>\n      </div>\n    </div>\n\n    <div class=\"page\" id=\"page-mis-llamadas\">\n      <p class=\"page-title\">Mis llamadas</p>\n      <p class=\"page-sub\">Historial de tu agente de voz</p>\n      <div class=\"metrics\" id=\"met-cliente\"><div class=\"loading\">Cargando...</div></div>\n      <div class=\"card\" style=\"padding:0\">\n        <div class=\"tbl-wrap\">\n          <table><thead><tr><th>Fecha</th><th>Nombre</th><th>Teléfono</th><th>Dur.</th><th>WA</th><th></th></tr></thead>\n          <tbody id=\"tbl-mis\"></tbody></table>\n        </div>\n      </div>\n      <div id=\"detail-panel-c\" class=\"detail-panel\">\n        <div class=\"detail-meta\" id=\"det-meta-c\"></div>\n        <div class=\"audio-player\" id=\"det-audio-c\"></div>\n        <div class=\"chat-box\" id=\"det-chat-c\"></div>\n        <div class=\"summary-sec\">\n          <div class=\"summary-label\">✨ Resumen</div>\n          <div class=\"summary-text\" id=\"det-summary-c\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"page\" id=\"page-analytics\">\n      <p class=\"page-title\">Analytics</p>\n      <p class=\"page-sub\">Rendimiento de tu agente este mes</p>\n      <div class=\"metrics\" id=\"met-analytics\"><div class=\"loading\">Cargando...</div></div>\n      <div class=\"grid2\">\n        <div class=\"card\"><div class=\"card-head\">📊 Distribución WA</div><div style=\"padding:16px\" id=\"chart-dist\"></div></div>\n        <div class=\"card\"><div class=\"card-head\">⏱ Duración promedio</div><div style=\"padding:16px\" id=\"chart-dur\"></div></div>\n      </div>\n    </div>\n\n    <div class=\"page\" id=\"page-mi-cuenta\">\n      <p class=\"page-title\">Mi cuenta</p>\n      <p class=\"page-sub\">Tu asistente y número de teléfono</p>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <div class=\"card-head\">🤖 Mi asistente</div>\n          <div style=\"padding:14px\"><table style=\"width:100%;font-size:13px\">\n            <tr><td style=\"color:#888;padding:5px 0;width:110px\">Nombre</td><td>Callcenter pruebas</td></tr>\n            <tr><td style=\"color:#888;padding:5px 0\">Modelo</td><td>GPT-4o Mini</td></tr>\n            <tr><td style=\"color:#888;padding:5px 0\">Voz</td><td>Daniela (11Labs)</td></tr>\n            <tr><td style=\"color:#888;padding:5px 0\">Estado</td><td><span class=\"badge b-si\">Activo</span></td></tr>\n          </table></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">📞 Mi número</div>\n          <div style=\"padding:14px\"><table style=\"width:100%;font-size:13px\">\n            <tr><td style=\"color:#888;padding:5px 0;width:110px\">Número</td><td>+59323420121</td></tr>\n            <tr><td style=\"color:#888;padding:5px 0\">Estado</td><td><span class=\"badge b-si\">Activo</span></td></tr>\n            <tr><td style=\"color:#888;padding:5px 0\">Webhook</td><td style=\"font-size:11px\">/webhook/vapi-transcripciones</td></tr>\n          </table></div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\nconst BASE='https://armacar.bkn.aigentss.cloud/webhook';\nlet session=null,allCalls=[],activeIdx=null,activePrefix=null;\n\ndocument.getElementById('inp-pass').addEventListener('keypress',e=>e.key==='Enter'&&doLogin());\n\nasync function doLogin(){\n  const email=document.getElementById('inp-email').value.trim();\n  const pass=document.getElementById('inp-pass').value;\n  if(!email||!pass)return;\n  try{\n    const res=await fetch(BASE+'/vd-login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password:pass})});\n    const d=await res.json();\n    if(d.success){\n      session=d;\n      document.getElementById('login-wrap').style.display='none';\n      document.getElementById('app').style.display='flex';\n      document.getElementById('user-em').textContent=email;\n      document.getElementById('user-av').textContent=email.substring(0,2).toUpperCase();\n      document.getElementById('error-box').style.display='none';\n      if(d.rol==='admin'){\n        document.getElementById('nav-admin').style.display='flex';\n        document.getElementById('nav-cliente').style.display='none';\n        loadAdmin();\n      }else{\n        document.getElementById('nav-admin').style.display='none';\n        document.getElementById('nav-cliente').style.display='flex';\n        loadCliente();\n      }\n    }else{document.getElementById('error-box').style.display='block';}\n  }catch(e){document.getElementById('error-box').style.display='block';}\n}\n\nfunction doLogout(){\n  session=null;allCalls=[];\n  document.getElementById('login-wrap').style.display='flex';\n  document.getElementById('app').style.display='none';\n  document.getElementById('inp-pass').value='';\n}\n\nfunction showPage(id,btn){\n  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));\n  document.getElementById('page-'+id).classList.add('active');\n  document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));\n  if(btn)btn.classList.add('active');\n  closeAllDetails();\n}\n\nasync function loadAdmin(){\n  try{\n    const[cr,cl]=await Promise.all([fetch(BASE+'/vd-calls').then(r=>r.json()),fetch(BASE+'/vd-clients').then(r=>r.json())]);\n    allCalls=cr.calls||[];\n    renderMetAdmin(allCalls);\n    renderTblPanel(allCalls.slice(0,5));\n    renderChartWA(allCalls,'chart-wa');\n    renderClientes(cl.clientes||[]);\n    renderTblLlamadas(allCalls);\n  }catch(e){console.error(e);}\n}\n\nasync function loadCliente(){\n  try{\n    const cr=await fetch(BASE+'/vd-calls').then(r=>r.json());\n    allCalls=cr.calls||[];\n    renderMetCliente(allCalls);\n    renderTblMis(allCalls);\n    renderAnalytics(allCalls);\n  }catch(e){console.error(e);}\n}\n\nfunction renderMetAdmin(c){\n  const t=c.length,wa=c.filter(x=>x.acepto_whatsapp==='SI').length,dur=c.reduce((a,x)=>a+parseFloat(x.duracion||0),0),p=t?(dur/t).toFixed(1):0;\n  document.getElementById('met-panel').innerHTML=`\n    <div class=\"metric\"><div class=\"metric-label\">Total llamadas</div><div class=\"metric-value\">${t}</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Aceptaron WA</div><div class=\"metric-value\">${wa}</div><div class=\"metric-sub\">${t?Math.round(wa/t*100):0}% conversión</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Duración prom.</div><div class=\"metric-value\">${p}m</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Leads WA</div><div class=\"metric-value\">${wa}</div></div>`;\n}\n\nfunction renderMetCliente(c){\n  const t=c.length,wa=c.filter(x=>x.acepto_whatsapp==='SI').length,dur=c.reduce((a,x)=>a+parseFloat(x.duracion||0),0);\n  document.getElementById('met-cliente').innerHTML=`\n    <div class=\"metric\"><div class=\"metric-label\">Total llamadas</div><div class=\"metric-value\">${t}</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Aceptaron WA</div><div class=\"metric-value\">${wa}</div><div class=\"metric-sub\">${t?Math.round(wa/t*100):0}%</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Minutos totales</div><div class=\"metric-value\">${dur.toFixed(1)}</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Costo est.</div><div class=\"metric-value\">$${(dur*0.11).toFixed(2)}</div></div>`;\n}\n\nfunction renderAnalytics(c){\n  const t=c.length,wa=c.filter(x=>x.acepto_whatsapp==='SI').length,no=t-wa,dur=t?(c.reduce((a,x)=>a+parseFloat(x.duracion||0),0)/t).toFixed(1):0;\n  document.getElementById('met-analytics').innerHTML=`\n    <div class=\"metric\"><div class=\"metric-label\">Conversión WA</div><div class=\"metric-value\">${t?Math.round(wa/t*100):0}%</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Total llamadas</div><div class=\"metric-value\">${t}</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Con WA</div><div class=\"metric-value\">${wa}</div></div>\n    <div class=\"metric\"><div class=\"metric-label\">Sin WA</div><div class=\"metric-value\">${no}</div></div>`;\n  renderChartWA(c,'chart-dist');\n  document.getElementById('chart-dur').innerHTML=`\n    <div style=\"font-size:32px;font-weight:600;color:#6366f1;margin-bottom:4px\">${dur}<span style=\"font-size:14px;color:#888;font-weight:400\"> min</span></div>\n    <div style=\"font-size:12px;color:#888;margin-bottom:14px\">Duración promedio por llamada</div>\n    <div class=\"bar-row\"><span style=\"font-size:11px;color:#888;width:80px\">vs. 5min obj.</span>\n    <div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${Math.min(parseFloat(dur)/5*100,100)}%;background:#6366f1\"></div></div></div>`;\n}\n\nfunction renderChartWA(c,id){\n  const t=c.length,wa=c.filter(x=>x.acepto_whatsapp==='SI').length,no=t-wa,pct=t?Math.round(wa/t*100):0;\n  document.getElementById(id).innerHTML=`\n    <div class=\"bar-row\"><span style=\"font-size:11px;color:#888;width:65px\">Aceptó WA</span><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${pct}%;background:#16A34A\"></div></div><span style=\"font-size:12px;font-weight:600;min-width:20px\">${wa}</span></div>\n    <div class=\"bar-row\"><span style=\"font-size:11px;color:#888;width:65px\">No aceptó</span><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${t?Math.round(no/t*100):0}%;background:#DC2626\"></div></div><span style=\"font-size:12px;font-weight:600;min-width:20px\">${no}</span></div>\n    <div style=\"margin-top:14px;font-size:28px;font-weight:600;color:#6366f1\">${pct}%<span style=\"font-size:13px;color:#888;font-weight:400\"> conversión</span></div>`;\n}\n\nfunction renderTblPanel(c){\n  const el=document.getElementById('tbl-panel');\n  if(!c.length){el.innerHTML='<tr><td colspan=\"4\" class=\"loading\">Sin llamadas</td></tr>';return;}\n  el.innerHTML=c.map(x=>`<tr><td style=\"color:#888;font-size:12px\">${x.fecha}</td><td>${x.nombre||'-'}</td><td>${x.duracion||0}m</td><td><span class=\"badge ${x.acepto_whatsapp==='SI'?'b-si':'b-no'}\">${x.acepto_whatsapp}</span></td></tr>`).join('');\n}\n\nfunction renderTblLlamadas(c){\n  const el=document.getElementById('tbl-llamadas');\n  if(!c.length){el.innerHTML='<tr><td colspan=\"7\" class=\"loading\">Sin llamadas</td></tr>';return;}\n  el.innerHTML=c.map((x,i)=>`<tr>\n    <td style=\"color:#888;font-size:11px;white-space:nowrap\">${x.fecha}</td>\n    <td>${x.nombre||'-'}</td><td style=\"font-size:12px\">${x.telefono||'-'}</td>\n    <td>${x.duracion||0}m</td>\n    <td><span class=\"badge ${x.acepto_whatsapp==='SI'?'b-si':'b-no'}\">${x.acepto_whatsapp}</span></td>\n    <td><span class=\"badge b-gray\" style=\"font-size:10px\">${fmtEstado(x.estado_llamada)}</span></td>\n    <td><button class=\"btn-sm\" onclick=\"toggleDetail(${i},'admin')\">Ver</button></td>\n  </tr>`).join('');\n}\n\nfunction renderTblMis(c){\n  const el=document.getElementById('tbl-mis');\n  if(!c.length){el.innerHTML='<tr><td colspan=\"6\" class=\"loading\">Sin llamadas</td></tr>';return;}\n  el.innerHTML=c.map((x,i)=>`<tr>\n    <td style=\"color:#888;font-size:11px;white-space:nowrap\">${x.fecha}</td>\n    <td>${x.nombre||'-'}</td><td style=\"font-size:12px\">${x.telefono||'-'}</td>\n    <td>${x.duracion||0}m</td>\n    <td><span class=\"badge ${x.acepto_whatsapp==='SI'?'b-si':'b-no'}\">${x.acepto_whatsapp}</span></td>\n    <td><button class=\"btn-sm\" onclick=\"toggleDetail(${i},'cliente')\">Ver</button></td>\n  </tr>`).join('');\n}\n\nfunction renderClientes(cl){\n  const cols=[['#EEF2FF','#6366f1'],['#DCFCE7','#15803d'],['#FEF9C3','#854d0e'],['#FEF2F2','#dc2626']];\n  if(!cl.length){document.getElementById('lista-clientes').innerHTML='<div class=\"loading\">Sin clientes</div>';return;}\n  document.getElementById('lista-clientes').innerHTML=cl.map((c,i)=>{\n    const[bg,fg]=cols[i%4];\n    return`<div class=\"client-row\"><div class=\"client-info\"><div class=\"c-avatar\" style=\"background:${bg};color:${fg}\">${c.nombre.substring(0,2).toUpperCase()}</div><div><div style=\"font-size:14px;font-weight:600\">${c.nombre}</div><div style=\"font-size:12px;color:#888\">${c.email} · ${c.numero||'Sin número'}</div></div></div><div style=\"display:flex;align-items:center;gap:8px\"><span class=\"badge ${c.activo==='true'?'b-si':'b-gray'}\">${c.activo==='true'?'Activo':'Inactivo'}</span><button class=\"btn-sm\">Editar</button></div></div>`;\n  }).join('');\n}\n\nfunction toggleDetail(idx,prefix){\n  const panelId=prefix==='admin'?'detail-panel':'detail-panel-c';\n  const panel=document.getElementById(panelId);\n  if(activeIdx===idx&&activePrefix===prefix&&panel.style.display==='block'){\n    closeAllDetails();return;\n  }\n  closeAllDetails();\n  activeIdx=idx;activePrefix=prefix;\n  const c=allCalls[idx];\n  const sfx=prefix==='admin'?'':'- c';\n  const metaId=prefix==='admin'?'det-meta':'det-meta-c';\n  const audioId=prefix==='admin'?'det-audio':'det-audio-c';\n  const chatId=prefix==='admin'?'det-chat':'det-chat-c';\n  const sumId=prefix==='admin'?'det-summary':'det-summary-c';\n\n  document.getElementById(metaId).innerHTML=`\n    <div class=\"meta-item\"><label>Nombre</label><span>${c.nombre||'-'}</span></div>\n    <div class=\"meta-item\"><label>Teléfono</label><span>${c.telefono||'-'}</span></div>\n    <div class=\"meta-item\"><label>Duración</label><span>${c.duracion||0} min</span></div>\n    <div class=\"meta-item\"><label>Aceptó WA</label><span><span class=\"badge ${c.acepto_whatsapp==='SI'?'b-si':'b-no'}\">${c.acepto_whatsapp}</span></span></div>\n    <div class=\"meta-item\"><label>Estado</label><span style=\"font-size:12px;color:#888\">${fmtEstado(c.estado_llamada)}</span></div>`;\n\n  buildAudio(audioId, c.grabacion, c.nombre);\n  buildChat(chatId, c.transcript||'', c.nombre);\n  document.getElementById(sumId).textContent=c.motivo||'Sin resumen disponible.';\n\n  panel.style.display='block';\n  panel.scrollIntoView({behavior:'smooth',block:'nearest'});\n}\n\nfunction closeAllDetails(){\n  document.querySelectorAll('.detail-panel').forEach(p=>p.style.display='none');\n  document.querySelectorAll('audio').forEach(a=>{a.pause();});\n  activeIdx=null;activePrefix=null;\n}\n\nfunction buildAudio(id, url, nombre){\n  const el=document.getElementById(id);\n  const hasAudio=url&&url!=='Sin grabacion'&&url.startsWith('http');\n  el.innerHTML=`\n    <div class=\"audio-player-title\">🎙️ Grabación de la llamada${nombre?' — '+nombre:''}</div>\n    ${hasAudio\n      ?`<audio class=\"audio-native\" controls preload=\"metadata\" src=\"${url}\">Tu navegador no soporta audio HTML5.</audio>\n         <a class=\"audio-dl\" href=\"${url}\" download target=\"_blank\">⬇ Descargar grabación</a>`\n      :`<div class=\"no-audio\">Sin grabación disponible para esta llamada.</div>`}`;\n}\n\nfunction buildChat(id, transcript, nombre){\n  const el=document.getElementById(id);\n  if(!transcript||transcript==='Sin transcripcion'){\n    el.innerHTML='<div style=\"text-align:center;padding:20px;color:#888;font-size:13px\">Sin transcripción disponible</div>';return;\n  }\n  const lines=transcript.split(/(?=AI:|User:)/).filter(l=>l.trim());\n  const initials=(nombre||'U').split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase();\n  el.innerHTML=lines.map(line=>{\n    const isAI=line.startsWith('AI:');\n    const text=line.replace(/^(AI:|User:)/,'').trim();\n    if(!text)return'';\n    return`<div class=\"msg-row ${isAI?'ai':'usr'}\">\n      <div class=\"msg-av ${isAI?'av-ai':'av-usr'}\">${isAI?'AI':initials}</div>\n      <div>\n        <div class=\"${isAI?'name-ai':'name-usr'}\" style=\"font-size:10px;font-weight:600;margin-bottom:3px;${isAI?'':'text-align:right'}\">${isAI?'Daniela':nombre||'Cliente'}</div>\n        <div class=\"bubble ${isAI?'bbl-ai':'bbl-usr'}\">${text}</div>\n      </div>\n    </div>`;\n  }).join('');\n  el.scrollTop=0;\n}\n\nfunction fmtEstado(s){\n  if(!s)return'-';\n  return s.replace('customer-ended-call','cliente colgó').replace('silence-timed-out','silencio').replace('assistant-ended-call','agente colgó');\n}\n\nfunction filtrar(){\n  const wa=document.getElementById('fil-wa').value;\n  const q=document.getElementById('fil-q').value.toLowerCase();\n  const f=allCalls.filter(c=>(!wa||c.acepto_whatsapp===wa)&&(!q||(c.nombre||'').toLowerCase().includes(q)||(c.telefono||'').includes(q)));\n  renderTblLlamadas(f);\n  closeAllDetails();\n}\n</script>\n</body>\n</html>\n",
