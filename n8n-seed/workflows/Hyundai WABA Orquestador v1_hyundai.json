      "parameters": {
        "jsCode": "const body = $json.body || {}\nconst msg = body?.conversation?.messages?.[0] || {}\nconst contact = body?.conversation?.meta?.sender || body?.conversation?.contact || {}\nconst sourcePhone = body?.conversation?.contact_inbox?.source_id || body?.source_id || ''\nconst content = msg.content || ''\n\nreturn [{\n  json: {\n    raw: body,\n    event: body.event || '',\n    message_type: body.message_type || '',\n    sender_type: (msg.sender_type || '').toLowerCase(),\n    conversation_id: body?.conversation?.id || null,\n    account_id: body?.account?.id || null,\n    inbox_id: body?.inbox?.id || null,\n    content,\n    source_number_phone: sourcePhone,\n    user_name_from_contact: contact?.name || '',\n    user_email_from_contact: contact?.email || '',\n    custom_attributes: body?.conversation?.contact?.custom_attributes || {},\n    contact_id: body?.conversation?.meta?.sender?.id || body?.conversation?.contact?.id || null\n  }\n}]"
      },
