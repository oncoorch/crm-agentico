    {
      "parameters": {
        "jsCode": "const intent = $json.output?.intent || 'fallback'\nconst data = $json.data_eval || {}\nconst guard = $json.flow_guard || {}\nconst waiting = Boolean($json.conversation_state?.waiting_for_flow_response)\n\nlet send_flow = false\nlet flow_type = 'none'\nlet reason = 'no_flow_needed'\nlet missing_fields = []\nlet next_stage = $json.conversation_state?.current_stage || 'discovery'\n\nif (guard.looksLikeFlowReply || waiting) {\n  send_flow = false\n  reason = guard.looksLikeFlowReply ? 'flow_reply_detected' : 'waiting_for_flow_response'\n} else if (intent === 'schedule_phase6') {\n  if (!data.contact_complete_basic) {\n    send_flow = true\n    flow_type = 'contact_basic'\n    missing_fields = data.missing_basic\n    reason = 'missing_basic_for_schedule'\n    next_stage = 'phase4'\n  } else if (!data.phase6_ready) {\n    send_flow = true\n    flow_type = data.missing_phase6.length <= 2 ? 'missing_fields' : 'phase6'\n    missing_fields = data.missing_phase6\n    reason = 'missing_phase6_fields'\n    next_stage = 'phase6'\n  } else {\n    send_flow = false\n    reason = 'ready_to_schedule'\n    next_stage = 'scheduled'\n  }\n} else if (intent === 'schedule_phase4' && guard.isCommercialIntent) {\n  if (!data.contact_complete_basic) {\n    send_flow = true\n    flow_type = 'contact_basic'\n    missing_fields = data.missing_basic\n    reason = 'missing_basic_fields'\n    next_stage = 'phase4'\n  }\n} else {\n  send_flow = false\n  reason = 'informational_turn'\n}\n\nreturn [{ json: { ...$json, routing: { intent, send_flow, flow_type, reason, missing_fields, next_stage } } }]"
      },
