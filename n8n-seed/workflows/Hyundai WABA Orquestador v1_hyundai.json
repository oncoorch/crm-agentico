    {
      "parameters": {
        "jsCode": "const text = ($json.content || '').trim()\nconst looksLikeFlowReply = /(name\\s*:|identifier\\s*:|email\\s*:|city\\s*:|dealer\\s*:|flow_token\\s*:)/i.test(text)\nconst isCommercialIntent = /(cotiz|precio|financia|cr[eé]dito|asesor|contact|compr|test drive|agend|cita|veh[ií]culo|modelo|concesionario|sucursal)/i.test(text)\nconst wantsSchedule = /(agend|test drive|cita|visita|ma[ñn]ana|hoy|hora|fecha)/i.test(text)\nconst missingBasic = []\nconst missingPhase6 = []\nconst c = $json.contact_state || {}\nconst l = $json.lead_state || {}\nfor (const f of ['name','identifier','email','phone_number','city','dealer']) {\n  const v = c[f]\n  if (v === null || v === undefined || String(v).trim() === '') missingBasic.push(f)\n}\nfor (const f of ['vehicle_model','test_drive_datetime','tentative_purchase_date']) {\n  const v = l[f]\n  if (v === null || v === undefined || String(v).trim() === '') missingPhase6.push(f)\n}\nreturn [{\n  json: {\n    ...$json,\n    flow_guard: { looksLikeFlowReply, isCommercialIntent, wantsSchedule },\n    data_eval: {\n      missing_basic: missingBasic,\n      missing_phase6: missingPhase6,\n      contact_complete_basic: missingBasic.length === 0,\n      phase6_ready: missingPhase6.length === 0\n    }\n  }\n}]"
      },
      "id": "1a754350-ff68-455e-856e-9397ea8b8068",
      "name": "Evaluate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1184,
        -64
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensaje del usuario:\n{{ $json.content }}\n\nContact State:\n{{ JSON.stringify($json.contact_state) }}\n\nLead State:\n{{ JSON.stringify($json.lead_state) }}\n\nConversation State:\n{{ JSON.stringify($json.conversation_state) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Eres un clasificador de intención para Hyundai en WhatsApp.\nResponde SOLO JSON con esta forma:\n{\n  \"intent\": \"product_info|corporate_info|dealership_info|schedule_phase4|schedule_phase6|fallback\",\n  \"confidence\": 0.0,\n  \"entities\": {\"city\":\"\",\"dealer\":\"\",\"model\":\"\"}\n}\nReglas:\n- schedule_phase6 si el usuario quiere agendar test drive, cita, visita o fecha/hora.\n- schedule_phase4 si quiere cotización, seguimiento, que le contacten o avanzar comercialmente, pero sin pedir fecha/hora.\n- product_info para preguntas de modelos, características, precio o disponibilidad sin intención clara de agendar.\n- corporate_info para preguntas corporativas.\n- dealership_info para sucursales, concesionarios, direcciones u horarios.\n- fallback si no es claro.\n- No agregues texto fuera del JSON."
            }
          ]
        },
        "batching": {}
      },
