    {
      "parameters": {
        "description": "Extrae direcciones IP IPv4 del texto de entrada y devuelve la IP pública (WAN) y privada (LAN).\nParses stdout para identificar IPs IPv4; filtra privadas y retorna última IP pública (WAN) y privadas (LAN).",
        "jsCode": "// Extrae dominio base y subdominio de una URL MCP\nconst input = items[0].json.url || items[0].json.server_url || items[0].json.text || '';\nconst urlPattern = /https?:\\/\\/([^/]+)/i;\nconst match = input.match(urlPattern);\n\nlet server_url = null;\nlet vps_name = null;\n\nif (match) {\n  server_url = `https://${match[1]}`;\n  const parts = match[1].split('.');\n  if (parts.length >= 3) vps_name = parts[0];\n  else vps_name = 'unknown';\n}\n\nreturn [\n  {\n    json: {\n      input,\n      server_url,\n      vps_name,\n      success: !!match,\n      timestamp: new Date().toISOString(),\n    }\n  }\n];\n"
      },
