        "command": "echo '{\n  \"hostname\": \"'$(hostname)'\",\n  \"os\": \"'$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '\"')'\",\n  \"kernel\": \"'$(uname -r)'\",\n  \"cpu_model\": \"'$(grep \"model name\" /proc/cpuinfo | head -n1 | cut -d: -f2 | xargs)'\",\n  \"cpu_cores\": \"'$(grep -c \"^processor\" /proc/cpuinfo)'\",\n  \"uptime_hours\": \"'$(awk \"{print int(\\$1/3600)}\" /proc/uptime)'\",\n  \"ram_total\": \"'$(free -h | awk \"/Mem:/ {print \\$2}\")'\",\n  \"ram_used\": \"'$(free -h | awk \"/Mem:/ {print \\$3}\")'\",\n  \"disk_total\": \"'$(df -h / | awk \"NR==2 {print \\$2}\")'\",\n  \"disk_used\": \"'$(df -h / | awk \"NR==2 {print \\$3}\")'\",\n  \"disk_usage\": \"'$(df -h / | awk \"NR==2 {print \\$5}\")'\",\n  \"load_avg\": \"'$(awk \"{print \\$1\\\", \\\"\\$2\\\", \\\"\\$3}\" /proc/loadavg)'\",\n  \"ipv4_addrs\": \"'$(ip -4 addr show | awk \"/inet / {print \\$2}\" | cut -d/ -f1 | paste -sd \",\" -)'\",\n  \"uptime_readable\": \"'$(awk \"{d=int(\\$1/86400);h=int((\\$1%86400)/3600);m=int((\\$1%3600)/60);printf \\\"%dd %dh %dm\\\",d,h,m}\" /proc/uptime)'\",\n  \"timestamp\": \"'$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")'\"\n}' | jq .\n"
