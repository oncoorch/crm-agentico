      "parameters": {
        "jsCode": "// Salida para agente WhatsApp outbound\nconst data = $input.first().json;\n\nreturn [{\n  json: {\n    accion: 'OUTBOUND_WHATSAPP',\n    telefono: data.telefono,\n    nombre: data.nombre,\n    motivo: data.motivo,\n    call_id: data.call_id,\n    timestamp: new Date().toISOString(),\n    estado: 'PENDIENTE',\n    mensaje_inicial: `Hola ${data.nombre}, le contactamos desde SIME Centros Médicos para continuar con su solicitud.`\n  }\n}];"
