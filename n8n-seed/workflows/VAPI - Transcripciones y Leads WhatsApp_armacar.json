      "name": "¿Es end-of-call?"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst message = body.message;\nconst call = message.call || {};\nconst artifact = message.artifact || {};\nconst analysis = message.analysis || {};\n\nconst transcript = artifact.transcript || 'Sin transcripcion';\n\nconst duracion = message.durationMinutes \n  ? Math.round(message.durationMinutes * 100) / 100 \n  : 0;\n\nconst transcriptLower = transcript.toLowerCase();\nconst acepto_whatsapp = (\n  transcriptLower.includes('whatsapp') && (\n    transcriptLower.includes('si') || \n    transcriptLower.includes('acepto') || \n    transcriptLower.includes('de acuerdo') || \n    transcriptLower.includes('claro') ||\n    transcriptLower.includes('perfecto')\n  )\n) ? 'SI' : 'NO';\n\nconst nombreMatch = transcript.match(/(?:me llamo|soy|mi nombre es)\\s+([A-Za-záéíóúÁÉÍÓÚñÑ]+(?:\\s+[A-Za-záéíóúÁÉÍÓÚñÑ]+)?)/i);\nconst nombre = nombreMatch ? nombreMatch[1] : 'No identificado';\n\nconst telefono = call.customer?.number || 'Web Call';\n\nconst motivo = analysis.summary || 'Sin resumen';\n\nconst fecha = new Date(message.startedAt || Date.now()).toLocaleString('es-EC', {\n  timeZone: 'America/Guayaquil'\n});\n\nconst grabacion = String(artifact.recordingUrl || 'Sin grabacion');\nconst grabacion_estereo = String(artifact.stereoRecordingUrl || 'Sin grabacion estereo');\nconst estado_llamada = String(message.endedReason || 'unknown');\n\nreturn [{\n  json: {\n    fecha: String(fecha),\n    nombre: String(nombre),\n    telefono: String(telefono),\n    motivo: String(motivo),\n    duracion: String(duracion),\n    transcript: String(transcript),\n    acepto_whatsapp: String(acepto_whatsapp),\n    grabacion: grabacion,\n    grabacion_estereo: grabacion_estereo,\n    estado_llamada: estado_llamada,\n    call_id: String(call.id || 'unknown')\n  }\n}];"
      },
