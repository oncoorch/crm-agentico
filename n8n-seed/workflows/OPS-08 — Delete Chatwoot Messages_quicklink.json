      "parameters": {
        "jsCode": "const src = $json.body || $json || {};\nconst rows = Array.isArray(src.messages) ? src.messages : [src];\nreturn rows.map((row, idx) => {\n  const conversationId = Number(row.conversation_id || row.chatwoot_conv_id || 0);\n  const messageId = Number(row.message_id || row.id || 0);\n  if (!conversationId || !messageId) throw new Error('conversation_id and message_id are required at index ' + idx);\n  if (src.confirm !== 'DELETE_CHATWOOT_MESSAGES') throw new Error('confirm=DELETE_CHATWOOT_MESSAGES is required');\n  return {\n    json: {\n      conversation_id: conversationId,\n      message_id: messageId,\n      account_id: Number(row.account_id || src.account_id || 2),\n      base_url: String(row.base_url || src.base_url || 'http://chatwoot:3000').replace(/\\/$/, ''),\n    }\n  };\n});"
      }
    },
