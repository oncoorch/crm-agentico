      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: {\n  ok: !item.json.error,\n  statusCode: item.json.statusCode || item.json.status || null,\n  conversation_id: item.json.conversation_id || null,\n  message_id: item.json.message_id || null,\n  response: item.json\n}}));"
      }
