      "name": "get_event_in_time_gap",
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "WxIL4h1aEEilZlIw",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const WORK_START_TIME = '09:00:00'; // Configurable work start time (24-hour format)\nconst WORK_END_TIME_WEEKDAY = '18:00:00'; // Configurable work end time for weekdays\nconst WORK_END_TIME_SATURDAY = '12:00:00'; // Configurable work end time for Saturday\nconst TIMEZONE = 'America/Bogota'; // Configurable timezone\nconst TIMEZONE_OFFSET = '-05:00'; // Configurable timezone offset (must match TIMEZONE)\n\nconst busyEvents = items.map(item => item.json);\n\n// Check if input is empty or contains only empty objects\nif (busyEvents.length === 0 || (busyEvents.length === 1 && Object.keys(busyEvents[0]).length === 0)) {\n  return [{ json: { message: \"available\" } }];\n}\n\nconst eventsByDate = {};\nbusyEvents.forEach(event => {\n  // Skip empty or invalid events\n  if (!event.start || !event.end) return;\n  const date = event.start.slice(0, 10);\n  if (!eventsByDate[date]) {\n    eventsByDate[date] = [];\n  }\n  eventsByDate[date].push({ start: event.start, end: event.end });\n});\n\nfunction formatWithOffset(ms) {\n  const options = {\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit',\n    hour12: false,\n    timeZone: TIMEZONE\n  };\n  const formatter = new Intl.DateTimeFormat('en-US', options);\n  const parts = formatter.formatToParts(new Date(ms));\n  const map = {};\n  parts.forEach(p => {\n    map[p.type] = p.value;\n  });\n  return `${map.year}-${map.month}-${map.day}T${map.hour}:${map.minute}:${map.second}${TIMEZONE_OFFSET}`;\n}\n\nconst slots = [];\n\nfor (const date in eventsByDate) {\n  const [year, month, day] = date.split('-').map(Number);\n  const dt = new Date(Date.UTC(year, month - 1, day));\n  const dayOfWeek = dt.getUTCDay();\n  if (dayOfWeek === 0) continue;\n\n  const workStartStr = `${date}T${WORK_START_TIME}${TIMEZONE_OFFSET}`;\n  const workEndStr = `${date}T${dayOfWeek === 6 ? WORK_END_TIME_SATURDAY : WORK_END_TIME_WEEKDAY}${TIMEZONE_OFFSET}`;\n  const workStartMS = new Date(workStartStr).getTime();\n  const workEndMS = new Date(workEndStr).getTime();\n\n  const busies = eventsByDate[date];\n  let busyIntervals = [];\n  busies.forEach(event => {\n    let startMS = new Date(event.start).getTime();\n    let endMS = new Date(event.end).getTime();\n    if (endMS <= workStartMS || startMS >= workEndMS) return;\n    startMS = Math.max(startMS, workStartMS);\n    endMS = Math.min(endMS, workEndMS);\n    busyIntervals.push({ startMS, endMS });\n  });\n\n  busyIntervals.sort((a, b) => a.startMS - b.startMS);\n\n  const merged = [];\n  busyIntervals.forEach(busy => {\n    if (merged.length === 0 || merged[merged.length - 1].endMS < busy.startMS) {\n      merged.push(busy);\n    } else {\n      merged[merged.length - 1].endMS = Math.max(merged[merged.length - 1].endMS, busy.endMS);\n    }\n  });\n\n  let prevEndMS = workStartMS;\n  merged.forEach(busy => {\n    addSlotsToArray(prevEndMS, busy.startMS);\n    prevEndMS = busy.endMS;\n  });\n  addSlotsToArray(prevEndMS, workEndMS);\n\n  function addSlotsToArray(gapStartMS, gapEndMS) {\n    const slotDurationMS = 30 * 60 * 1000;\n    if (gapEndMS - gapStartMS < slotDurationMS) return;\n    let currentStartMS = gapStartMS;\n    while (currentStartMS + slotDurationMS <= gapEndMS) {\n      const currentEndMS = currentStartMS + slotDurationMS;\n      slots.push({\n        start: formatWithOffset(currentStartMS),\n        end: formatWithOffset(currentEndMS),\n        duration: 30\n      });\n      currentStartMS = currentEndMS;\n    }\n  }\n}\n\nreturn slots.map(slot => ({ json: slot }));"
      },
