      "parameters": {
        "jsCode": "// Generador de hash determinístico simple (FNV-1a modificado)\nfunction simpleHash(str) {\n  let hash = 2166136261;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = Math.imul(hash, 16777619);\n  }\n  // Convierte a hexadecimal de longitud fija\n  return (hash >>> 0).toString(16).padStart(8, '0');\n}\n\nreturn items.map(item => {\n  const varname = $('Doy_Folder').first().json.Folder || '';\n  //const varname = ($('Map Year&Doy').first().json.Year + 1) || '';\n  const cleanvarname = varname.replace('/', '');\n  const id_hash = simpleHash(cleanvarname);\n\n  item.json.id_hash = id_hash;\n  return item;\n});"
