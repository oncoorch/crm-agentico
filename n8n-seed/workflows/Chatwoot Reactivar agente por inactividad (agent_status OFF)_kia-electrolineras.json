      "name": "Generar páginas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        -512
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.CHATWOOT_BASE_URL + \"/api/v1/accounts/\" + $json.ACCOUNT_ID + \"/conversations\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "all"
            },
            {
              "name": "page",
              "value": "={{ $json.page }}"
            },
            {
              "name": "labels",
              "value": "human_support, agente_off, electrical_emergency"
            }
          ]
        },
        "sendHeaders": true,
