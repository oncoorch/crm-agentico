    {
      "parameters": {
        "jsCode": "const cfg = items[0].json;\nconst maxPages = Number(cfg.MAX_PAGES || 20);\nconst out = [];\nfor (let page = 1; page <= maxPages; page++) {\n  out.push({ json: { ...cfg, page } });\n}\nreturn out;"
      },
