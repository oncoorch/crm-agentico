        "httpHeaderAuth": {
          "id": "QqrhAYRqgc1DLDqt_kia-electrolineras",
          "name": "Chatwoot Update Admin_KIA ELECTROLINERAS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const original = $('Filtrar elegibles para reactivar').all()[index].json;\n\n  return {\n    json: {\n      conversation_id: original.conversation_id,\n      display_id: original.display_id ?? null,\n      had_agente_off: original.had_agente_off ?? false,\n      labels_before: original.labels_before ?? [],\n      labels_after: original.labels_after ?? [],\n      idle_minutes_current: original.idle_minutes_current ?? null,\n      custom_attributes: {\n        agent_status: 'ON'\n      }\n    }\n  };\n});"
      },
