        -512
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "QqrhAYRqgc1DLDqt_kia-electrolineras",
          "name": "Chatwoot Update Admin_KIA ELECTROLINERAS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $json;\nconst rows = src.data?.payload ?? [];\nconst cfg = $('Config').first().json;\n\nconst nowMs = Date.now();\nconst idleMinutes = Number(cfg.IDLE_MINUTES || 5);\nconst idleMsRequired = idleMinutes * 60 * 1000;\n\nconst out = [];\n\nfor (const conv of rows) {\n  const labels = Array.isArray(conv.labels) ? conv.labels : [];\n  const custom = conv.custom_attributes || {};\n  const status = String(custom.agent_status || '').toUpperCase();\n\n  const lastActivityAtSec = Number(conv.last_activity_at || 0);\n  const lastActivityMs = lastActivityAtSec > 0 ? lastActivityAtSec * 1000 : 0;\n  const idleMs = lastActivityMs > 0 ? (nowMs - lastActivityMs) : 0;\n\n  //if (status !== 'OFF') continue;\n  if (lastActivityMs === 0) continue;\n  if (idleMs < idleMsRequired) continue;\n\n  out.push({\n    json: {\n      CHATWOOT_BASE_URL: cfg.CHATWOOT_BASE_URL,\n      ACCOUNT_ID: cfg.ACCOUNT_ID,\n      API_TOKEN: cfg.API_TOKEN,\n      IDLE_MINUTES: idleMinutes,\n      conversation_id: conv.id,\n      display_id: conv.display_id ?? null,\n      labels_before: labels,\n      labels_after: labels.filter(lb => lb !== 'agente_off'),\n      had_agente_off: labels.includes('agente_off'),\n      last_activity_at: conv.last_activity_at,\n      idle_minutes_current: Math.floor(idleMs / 60000),\n      custom_attributes_before: custom\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "10804e8c-df49-47b3-ac0b-7c3372cde6c4",
