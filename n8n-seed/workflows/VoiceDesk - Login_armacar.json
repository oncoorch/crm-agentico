      "parameters": {
        "jsCode": "const body = $('Webhook Login').first().json.body;\nconst email = body.email;\nconst password = body.password;\nconst usuarios = $input.all();\n\nconst usuario = usuarios.find(u => \n  u.json.email === email && \n  u.json.password === password\n);\n\nif (!usuario) {\n  return [{ json: { success: false, message: 'Credenciales incorrectas' } }];\n}\n\nreturn [{ json: {\n  success: true,\n  email: usuario.json.email,\n  rol: usuario.json.rol,\n  cliente_id: usuario.json.cliente_id,\n  token: Buffer.from(email + ':' + Date.now()).toString('base64')\n}}];"
