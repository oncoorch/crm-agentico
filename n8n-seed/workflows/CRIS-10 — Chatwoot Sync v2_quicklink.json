    {
      "parameters": {
        "jsCode": "const conv     = $input.first().json;\nconst prev     = $('Code - Normalize Phone').first().json;\nconst status   = conv.status || '';\nconst isActive = ['open','pending'].includes(status);\nreturn [{\n  json: {\n    ...prev,\n    existing_conv_id:     isActive ? (prev.lm_conv_id || null) : null,\n    existing_contact_id:  isActive ? (prev.lm_contact_id || null) : null,\n    conv_reused:          isActive,\n    existing_conv_status: status,\n  }\n}];"
      },
