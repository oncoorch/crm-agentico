    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n// Fuentes posibles de los IDs:\n//   conv reutilizada de lead_memory    → existing_conv_id / active_conv_id\n//   conv nueva creada en Create Conv   → input.id\nconst convResult = input;\nconst orig = input;\n\n// Determinar conv_id final\nlet finalConvId = 0;\nlet finalContactId = 0;\nlet reused = false;\n\nif (orig.existing_conv_id && orig.conv_reused) {\n  // Rama: conv verificada desde lead_memory (branch IF - Conv Still Active = TRUE)\n  finalConvId     = orig.existing_conv_id;\n  finalContactId  = orig.existing_contact_id || 0;\n  reused          = true;\n} else if (orig.active_conv_id && orig.conv_reused) {\n  // Rama: conv activa encontrada en contacto Chatwoot\n  finalConvId     = orig.active_conv_id;\n  finalContactId  = orig.contact_id || 0;\n  reused          = true;\n} else {\n  // Rama: conv nueva creada\n  finalConvId     = orig.id || orig.chatwoot_conv_id || 0;\n  finalContactId  = orig.contact_id ||\n    (orig.meta && orig.meta.sender ? orig.meta.sender.id : 0) || 0;\n  reused          = false;\n}\n\nconst syncOk = finalConvId > 0;\nconst payload = JSON.stringify({\n  chatwoot_conv_id: syncOk ? finalConvId : null,\n  chatwoot_contact_id: finalContactId > 0 ? finalContactId : null,\n  reused,\n  error: syncOk ? null : 'conv_id_missing'\n}).replace(/'/g, \"''\");\n\nreturn [{\n  json: {\n    conv_id:            orig.conv_id,\n    phone_e164:         orig.phone_e164,\n    chatwoot_contact_id: finalContactId,\n    chatwoot_conv_id:   finalConvId,\n    sync_ok:            syncOk,\n    conv_reused:        reused,\n    evento_tipo:        syncOk ? 'chatwoot_sync_completado' : 'chatwoot_sync_fallido',\n    evento_payload:     payload,\n  }\n}];"
      },
