    {
      "parameters": {
        "jsCode": "const resp      = $input.first().json;\nconst prev      = $('Code - After Search').first().json;\nconst convList  = (resp.data && resp.data.payload) ? resp.data.payload\n                  : (resp.payload || []);\nconst inboxId   = prev.inbox_id || 2;\n\n// Buscar conversación abierta o pendiente en el inbox correcto\nconst active = convList.find(c =>\n  c.inbox_id === inboxId &&\n  ['open','pending'].includes(c.status)\n);\n\nreturn [{\n  json: {\n    ...prev,\n    active_conv_found: !!active,\n    active_conv_id:    active ? active.id : null,\n    active_conv_status: active ? active.status : null,\n    conv_reused:       !!active,\n  }\n}];"
      },
