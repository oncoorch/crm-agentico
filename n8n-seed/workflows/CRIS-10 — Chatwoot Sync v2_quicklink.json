      "parameters": {
        "jsCode": "const res  = $input.first().json || {};\nconst prev = $('Code - Normalize Phone').first().json;\nconst contactId = Number(res.id || 0) || null;\nif (!contactId) {\n  return [];\n}\nreturn [{\n  json: {\n    ...prev,\n    contact_id: contactId,\n    contact_found: true,\n    active_conv_found: false,\n    active_conv_id: null,\n    conv_reused: false,\n  }\n}];"
