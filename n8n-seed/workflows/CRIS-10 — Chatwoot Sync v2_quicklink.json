    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst rawPhone = String(item.telefono || '').replace(/[\\s\\-\\(\\)]/g, '');\nif (!item.conv_id || !rawPhone) {\n  return [];\n}\nlet phone = rawPhone;\nif (!phone.startsWith('+')) {\n  phone = '+593' + phone.replace(/^0+/, '');\n}\nif (!/^\\+\\d{8,15}$/.test(phone) || phone === '+593') {\n  return [];\n}\nconst phoneLocal = phone.replace(/^\\+593/, '');\nreturn [{\n  json: {\n    conv_id:     item.conv_id,\n    nombre:      item.nombre || 'Prospecto',\n    marca:       item.marca  || '',\n    modelo:      item.modelo || '',\n    quicklink_id: item.quicklink_id || '',\n    inbox_id:    item.inbox_id || 2,\n    phone_e164:  phone,\n    phone_local: phoneLocal,\n    // Datos de lead_memory ya traídos en el query\n    lm_contact_id: item.lm_contact_id || null,\n    lm_conv_id:    item.lm_conv_id    || null,\n    lm_phone:      item.lm_phone      || phone,\n  }\n}];"
      },
