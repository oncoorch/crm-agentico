    {
      "parameters": {
        "jsCode": "const searchResult = $input.first().json;\nconst prev         = $('Code - Normalize Phone').first().json;\nconst contacts     = searchResult.payload || [];\nconst found        = contacts.length > 0;\nconst contactId    = found ? contacts[0].id : null;\nreturn [{\n  json: {\n    ...prev,\n    contact_found: found,\n    contact_id:    contactId,\n  }\n}];"
      },
