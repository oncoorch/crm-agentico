      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nlet isWebhook = false, reqBody = {};\ntry { if ($('Webhook - Run Nightly Now').isExecuted) { isWebhook = true; reqBody = $('Webhook - Run Nightly Now').first().json.body || {}; } } catch (e) {}\nconst raw = $json.body !== undefined ? $json.body : $json;\nconst payload = Array.isArray(raw) ? (raw[0] || {}) : (raw || {});\nconst status = String(payload.status || 'UNKNOWN').toUpperCase();\nconst summary = payload.summary || {};\nconst failed = Number(summary.failed || 0);\nconst today = new Date().toISOString().slice(0, 10);\nconst forceTest = reqBody.test_alert === true || reqBody.test_alert === '1' || reqBody.test_alert === 1;\nconst alert = forceTest || failed > 0 || status === 'FAILED';\nif (!alert) { if (!isWebhook) staticData.lastNightlyOk = today; return [{ json: { send_alert: false, status, summary, run_key: payload.run_key || null } }]; }\nif (!isWebhook && !forceTest && staticData.lastAlertDate === today) { return [{ json: { send_alert: false, status: 'already_alerted_today', summary } }]; }\nif (!isWebhook) staticData.lastAlertDate = today;\nconst head = forceTest ? 'CRIS QA — [TEST alerta nightly]' : 'CRIS QA — Nightly FALLÓ';\nconst lines = [head + ' (' + today + ')', ''];\nlines.push('Catalogo (gate, 11 ship-blockers) status: ' + status);\nlines.push('casos: ' + (summary.passed || 0) + ' ok / ' + failed + ' fail / ' + (summary.skipped || 0) + ' skip (total ' + (summary.total || 0) + ')');\nif (summary.findings) lines.push('findings: ' + summary.findings);\nlines.push('');\nlines.push('Panel QA-06 · run ' + (payload.run_key || payload.run_id || '?'));\nreturn [{ json: { send_alert: true, status, summary, meta_payload: { messaging_product: 'whatsapp', recipient_type: 'individual', to: '5521999910781', type: 'text', text: { preview_url: false, body: lines.join('\\n').slice(0, 3900) } } } }];"
      }
    },
