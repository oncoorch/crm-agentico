      "id": "pg-acquire-migration-lock-001",
      "name": "Postgres - Acquire Migration Lock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        112,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "bpXsDuBulR5Lk1Yf_quicklink",
          "name": "Supabase VPS_QUICKLINK"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO sales_prod, public, extensions;\nCREATE TABLE IF NOT EXISTS ops_migration_mutex (\n  lock_name text PRIMARY KEY,\n  owner text,\n  locked_until timestamptz NOT NULL DEFAULT '-infinity'\n);\nINSERT INTO ops_migration_mutex (lock_name, owner, locked_until)\nVALUES ('OPS-04', '{{ $execution.id }}', 'infinity')\nON CONFLICT (lock_name) DO UPDATE\nSET owner = EXCLUDED.owner, locked_until = EXCLUDED.locked_until\nWHERE ops_migration_mutex.owner IS NULL\n   OR ops_migration_mutex.owner = EXCLUDED.owner;\nDO $lock$\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM ops_migration_mutex\n    WHERE lock_name = 'OPS-04' AND owner = '{{ $execution.id }}'\n  ) THEN\n    RAISE EXCEPTION 'OPS-04 migration lock is held by another execution';\n  END IF;\nEND;\n$lock$;\nSELECT 'acquired' AS lock_status;",
        "options": {}
      }
    },
    {
      "id": "pg-release-migration-lock-complete-001",
