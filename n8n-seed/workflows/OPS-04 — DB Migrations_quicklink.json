    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO sales_prod, public, extensions;\nINSERT INTO flyway_schema_history\n  (installed_rank,version,description,type,script,checksum,installed_by,execution_time,success)\nSELECT\n  COALESCE((SELECT MAX(installed_rank) FROM flyway_schema_history),0)+1,\n  '{{ $json.version }}',\n  '{{ $json.description }}',\n  'SQL',\n  'V{{ $json.version }}__{{ $json.description }}.sql',\n  {{ $json.checksum }},\n  'n8n',\n  0,\n  true\nWHERE NOT EXISTS (\n  SELECT 1 FROM flyway_schema_history WHERE version='{{ $json.version }}'\n);\nSELECT '{{ $json.version }}' AS version_applied;",
        "options": {}
      },
