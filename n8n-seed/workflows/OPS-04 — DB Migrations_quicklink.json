      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1800,
        160
      ],
      "credentials": {
        "postgres": {
          "id": "bpXsDuBulR5Lk1Yf_quicklink",
          "name": "Supabase VPS_QUICKLINK"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO sales_prod, public, extensions;\nUPDATE ops_migration_mutex\nSET owner = NULL, locked_until = now()\nWHERE lock_name = 'OPS-04' AND owner = '{{ $execution.id }}';\nSELECT 'completed' AS status, 'Todas las migraciones pendientes aplicadas exitosamente' AS message;",
        "options": {}
      }
    },
