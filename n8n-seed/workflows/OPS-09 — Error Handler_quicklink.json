    {
      "parameters": {
        "jsCode": "const data = $json || {};\nconst wf = data.workflow || {};\nconst exec = data.execution || {};\nconst err = exec.error || (data.trigger && data.trigger.error) || data.error || {};\nconst clip = (v, n) => String(v == null ? '' : v).slice(0, n);\nconst nodeName = clip(err.node && err.node.name || exec.lastNodeExecuted || '', 200);\nconst message = clip(err.message || err.description || 'unknown error', 900);\nconst wfId = clip(wf.id || '', 60);\nconst wfName = clip(wf.name || '', 200);\nconst execId = clip(exec.id || '', 60);\nconst execUrl = clip(exec.url || (wfId && execId ? 'https://quicklink.bkn.aigentss.cloud/workflow/' + wfId + '/executions/' + execId : ''), 300);\nconst alertText = [\n  'CRIS OPS-09 — ERROR DE WORKFLOW',\n  'Workflow: ' + (wfName || wfId || 'desconocido'),\n  'Nodo: ' + (nodeName || '-'),\n  'Error: ' + message,\n  execUrl ? 'Ejecucion: ' + execUrl : null,\n  'Hora: ' + new Date().toISOString(),\n].filter(Boolean).join('\\n');\nreturn [{ json: {\n  workflow_id: wfId || 'unknown',\n  workflow_name: wfName,\n  execution_id: execId,\n  node_name: nodeName,\n  error_message: message,\n  error_stack: clip(err.stack || '', 2000),\n  execution_url: execUrl,\n  meta_payload: {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual',\n    to: '5521999910781',\n    type: 'text',\n    text: { preview_url: false, body: alertText },\n  },\n} }];"
      },
      "id": "ops09-normalize",
      "name": "Code - Normalize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO sales_prod, public, extensions;\nWITH ins AS (\n  INSERT INTO workflow_errors (workflow_id, workflow_name, execution_id, node_name, error_message, error_stack, execution_url)\n  VALUES ($1, $2, $3, $4, $5, $6, $7)\n  RETURNING id, workflow_id\n)\nSELECT ins.id AS error_id,\n  (SELECT count(*)::int FROM workflow_errors we\n     WHERE we.workflow_id = ins.workflow_id\n       AND we.alerted = true\n       AND we.occurred_at > now() - interval '30 minutes'\n       AND we.id <> ins.id) AS recent_alerts\nFROM ins;",
        "options": {
          "queryReplacement": "={{ [$json.workflow_id, $json.workflow_name, $json.execution_id, $json.node_name, $json.error_message, $json.error_stack, $json.execution_url] }}"
        }
      },
