      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO eventos_conversacion (conversation_id, tipo_evento, actor, payload) VALUES ('{{ $('Code - Build Labels Attrs').first().json.conv_id }}'::uuid, 'chatwoot_labels_aplicados', 'sistema', '{{ $('Code - Build Labels Attrs').first().json.evento_payload }}')",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "bpXsDuBulR5Lk1Yf_quicklink",
          "name": "Supabase VPS_QUICKLINK"
        }
      }
    }
