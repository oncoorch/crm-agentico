        "jsCode": "function toBool(value, fallback = false) {\n  if (typeof value === 'boolean') return value;\n  if (value === undefined || value === null || value === '') return fallback;\n  const text = String(value).trim().toLowerCase();\n  return ['1', 'true', 'yes', 'si', 'sí'].includes(text);\n}\n\nconst accountId = String($json.account_id || '').trim();\nconst inboxId = String($json.inbox_id || '').trim();\nconst payload = {\n  dry_run: toBool($json.dry_run, false),\n  max_items: Number($json.max_items || 100),\n  lookback_hours: Number($json.lookback_hours || 168),\n  due_after_minutes: Number($json.due_after_minutes || 1440),\n  include_synthetic_ddt2: toBool($json.include_synthetic_ddt2, false),\n  service_id: Number($json.service_id || 1),\n  create_private_notes: toBool($json.create_private_notes, true),\n  resolve_conversations: toBool($json.resolve_conversations, true),\n};\nif (accountId) payload.account_id = Number(accountId);\nif (inboxId) payload.inbox_id = Number(inboxId);\nreturn [{ json: { ...$json, payload } }];"
      },
