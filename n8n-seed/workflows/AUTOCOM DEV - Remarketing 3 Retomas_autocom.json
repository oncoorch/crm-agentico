        "jsCode": "function parseSchedule(value) {\n  if (Array.isArray(value)) return value;\n  const text = String(value || '').trim();\n  if (!text) return [];\n  try {\n    const parsed = JSON.parse(text);\n    if (Array.isArray(parsed)) return parsed;\n  } catch (error) {\n    // Fall through to comma-separated parsing.\n  }\n  return text.split(',').map((part) => part.trim());\n}\n\nfunction normalizeSchedule(value) {\n  const values = parseSchedule(value);\n  const schedule = [];\n  let previous = 0;\n  for (const value of values) {\n    const minutes = Number(value);\n    if (!Number.isFinite(minutes) || minutes <= previous) continue;\n    schedule.push(Math.trunc(minutes));\n    previous = Math.trunc(minutes);\n    if (schedule.length === 2) break;\n  }\n  return schedule.length ? schedule : [240, 1440];\n}\n\nfunction isTrue(value) {\n  return value === true || ['1', 'true', 'yes', 'si'].includes(String(value || '').trim().toLowerCase());\n}\n\nconst accountId = Number($json.account_id || 0);\nconst inboxId = Number($json.inbox_id || 0);\nconst payload = {\n  dry_run: isTrue($json.dry_run),\n  live_send_confirmed: isTrue($json.live_send_confirmed),\n  service_followup_only: isTrue($json.service_followup_only),\n  campaign_send_confirmed: isTrue($json.campaign_send_confirmed),\n  candidate_scan_limit: Number($json.candidate_scan_limit || 250),\n  max_items: Number($json.max_items || $json.candidate_scan_limit || 250),\n  max_sends_per_run: Number($json.max_sends_per_run || 5),\n  max_sends_per_hour: Number($json.max_sends_per_hour || 10),\n  max_sends_per_day: Number($json.max_sends_per_day || 25),\n  remarketing_schedule_minutes: normalizeSchedule($json.remarketing_schedule_minutes),\n  max_attempts: Math.min(Math.max(Number($json.max_attempts || 2), 1), 2),\n  lookback_hours: Number($json.lookback_hours || 48),\n  business_days: $json.business_days || [0, 1, 2, 3, 4],\n  business_hour_start: Number($json.business_hour_start || 9),\n  business_hour_end: Number($json.business_hour_end || 18),\n};\nif (accountId) payload.account_id = accountId;\nif (inboxId) payload.inbox_id = inboxId;\nreturn [{ json: { ...$json, payload } }];"
      },
