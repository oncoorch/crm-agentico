        "name": "generar_grafico",
        "description": "Genera un gráfico y devuelve una URL de imagen. Úsala cuando el usuario pida un gráfico o visualización. Recibe la configuración del gráfico en formato Chart.js.",
        "jsCode": "// El modelo provee la config Chart.js como JSON\nconst chartConfig = $fromAI('chart_config', 'Configuración del gráfico en formato Chart.js (type, data, options)', 'string');\nconst encoded = encodeURIComponent(typeof chartConfig === 'string' ? chartConfig : JSON.stringify(chartConfig));\nconst url = `https://quickchart.io/chart?c=${encoded}&backgroundColor=white&width=600&height=400`;\nreturn `Gráfico generado. URL de imagen lista para enviar: ${url}`;"
      },
