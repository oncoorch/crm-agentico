      "id": "qa-smoke-options",
      "name": "Prepare Smoke Options",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body && typeof input.body === 'object' ? input.body : {};\nconst toBool = (value, fallback) => {\n  if (value === undefined || value === null || value === '') return fallback;\n  if (typeof value === 'boolean') return value;\n  return !['0', 'false', 'no', 'off'].includes(String(value).trim().toLowerCase());\n};\nreturn [{\n  json: {\n    include_appointments: toBool(body.include_appointments, true),\n    include_known_gaps: toBool(body.include_known_gaps, true),\n  },\n}];"
      }
    },
    {
      "id": "qa-run-mcp-smoke",
      "name": "Run MCP Conversation Smoke",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://mcp_server:8000/api/qa/conversation-smoke",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-qa-smoke-token",
              "value": "={{ $env.QA_SMOKE_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ include_appointments: Boolean($json.include_appointments), include_known_gaps: Boolean($json.include_known_gaps) }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      }
    },
    {
      "id": "qa-format-summary",
      "name": "Format Smoke Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const report = $input.first().json || {};\nconst summary = report.summary && typeof report.summary === 'object' ? report.summary : {};\nconst endpointReachable = Boolean(report.version && report.summary);\nconst failures = Array.isArray(report.failures) ? report.failures : [];\nreturn [{\n  json: {\n    ok: endpointReachable && report.ok === true,\n    endpoint_reachable: endpointReachable,\n    version: report.version || null,\n    generated_at: report.generated_at || null,\n    mode: report.mode || null,\n    total: Number(summary.total || 0),\n    passed: Number(summary.passed || 0),\n    failed: Number(summary.failed || 0),\n    blocking_failed: Number(summary.blocking_failed || 0),\n    known_gaps: Number(summary.known_gaps || 0),\n    skipped: Number(summary.skipped || 0),\n    safety: report.safety || {},\n    failures,\n    cases: Array.isArray(report.cases) ? report.cases : [],\n    error: report.error || null,\n  },\n}];"
      }
    }
