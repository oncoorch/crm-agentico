TZ=America/Guayaquil

# Public hosts
CRM_PUBLIC_URL=https://crm.oncoorch.com
N8N_PUBLIC_URL=https://automation-crm.oncoorch.com
EVOLUTION_PUBLIC_URL=https://evolution.oncoorch.com
MCP_PUBLIC_URL=https://crm-agent.oncoorch.com

# Images
# Use an authorized custom image if your Chatwoot license/vendor agreement requires it.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.6.0
MCP_IMAGE=

# Chatwoot
CHATWOOT_POSTGRES_PASSWORD=change_me
CHATWOOT_REDIS_PASSWORD=change_me
CHATWOOT_SECRET_KEY_BASE=change_me
CHATWOOT_RAILS_MAX_THREADS=5
CHATWOOT_SIDEKIQ_CONCURRENCY=10
CHATWOOT_ENABLE_AGENT_API=true
CHATWOOT_ALLOW_AGENT_API_TOKENS=true
CHATWOOT_ENABLE_AGENT_SIGNUP=false
CHATWOOT_ENABLE_INBOX_APPROVAL=false
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=1

# Meta channels
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_API_VERSION=v24.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# n8n
N8N_POSTGRES_PASSWORD=change_me
N8N_REDIS_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Evolution API
EVOLUTION_API_KEY=change_me
EVOLUTION_POSTGRES_PASSWORD=change_me

# MCP / lead bridge
MCP_SHARED_SECRET=change_me
MCP_DB_HOST=
